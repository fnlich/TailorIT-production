# --- v3.0: the job feeds' limits (v30 S4) -----------------------------------------------------------------------------
# Requests a day to Himalayas' jobs API, shared by every Himalayas source (Himalayas allows 10,000). Also in Admin › Constants.
# HIMALAYAS_REQUESTS_PER_DAY=9000
# end v30 S4
# --- v3.0: the W6 ingest fixes (v30 FIX-A) ---------------------------------------------------------------------------
# Discovery reads found Greenhouse, Lever, Ashby and Workable boards with INGEST_USER_AGENT before BOT_USER_AGENT is set;
# false makes them wait for BOT_USER_AGENT like every other kind. Also in Admin › Constants.
# DISCOVERY_VALIDATE_V2_KINDS_TODAY=true
# MSG_INGEST_SOURCE_OPTED_OUT=This source's company asked TailorIT not to read its jobs, so it stays off. Take the company's opt-out off first (Admin › Companies).
# end v30 FIX-A
# --- v3.0: live Wikidata lookups (v30 FIX-C) ------------------------------------------------------------------------
# Company enrichment asks Wikidata's two APIs about companies the monthly dumps have not seen (with BOT_USER_AGENT set).
# Off until the operator accepts the robots.txt exception for those APIs (DEPLOY.md). Also in Admin › Constants.
# REFDATA_LIVE_LOOKUPS=false
# end v30 FIX-C
# --- v3.0: the held job's title (v30 FIX-B) ----------------------------------------------------------------------------
# MSG_JOB_HELD_TITLE=Waiting for approval
# end v30 FIX-B
# --- v3.0: numbers the admin pages say in words (v30 FIX-WEB, REQ-7) ------------------------------------------------
# USAJOBS' own cap on one search's rows, and Jobicy's one read an hour (the services' rules: .env only). The reporters'
# trust window is also in Admin › Constants.
# USAJOBS_MAX_ROWS=10000
# JOBICY_READ_GAP_MINUTES=60
# TRUST_REJECT_WINDOW_DAYS=30
# The mark of a saved or tracked job that closed (also in Admin › Constants).
# LABEL_JOB_CLOSED_MARK=Closed
# Add source's notes on the feeds and a career site ({max} and {gap} are filled from the two numbers above).
# MSG_SOURCE_NOTE_USAJOBS=Every open USAJOBS announcement (up to {max} a source). It runs once BOT_USER_AGENT names TailorIT's bot page and mailbox and USAJOBS_API_KEY is set in .env.
# MSG_SOURCE_NOTE_JOBICY=Jobicy's newest remote jobs in one region, read at most {gap}. It runs once BOT_USER_AGENT names TailorIT's bot page and mailbox.
# MSG_SOURCE_NOTE_HIMALAYAS=Himalayas' remote jobs open to one country. It runs once BOT_USER_AGENT names TailorIT's bot page and mailbox and HIMALAYAS_API_KEY is set in .env.
# MSG_SOURCE_NOTE_CAREER_SITE=Its job pages are read through the polite site reader, robots.txt and the host's pace included. It runs once Read career pages is on in Admin › Constants and BOT_USER_AGENT names TailorIT's bot page and mailbox.
# end v30 FIX-WEB
# --- v3.0: the Jobs page's filter counts, kept (v30 FIX-PG, PGL-5) ------------------------------------------------------
# The filter lists' counts over the shared jobs are kept and counted again in the background once older than
# JOB_FACETS_REFRESH_MINUTES (0: at every request); under JOB_FACETS_CACHE_MIN_JOBS open jobs they are counted at every
# request. Also in Admin › Constants.
# JOB_FACETS_REFRESH_MINUTES=10
# JOB_FACETS_CACHE_MIN_JOBS=20000
# end v30 FIX-PG
